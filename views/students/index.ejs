<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <h1>Students</h1>
    <div class="sub"><%= students.length %> <%= status %> student<%= students.length === 1 ? '' : 's' %><%= pendingOnly ? ' with pending fees' : '' %></div>
  </div>
  <div class="actions">
    <a class="btn btn-primary" href="/students/new<%= batchId ? `?batch=${batchId}` : '' %>"><%- include('../partials/icon', { name: 'plus' }) %> Add student</a>
  </div>
</div>

<form class="filters" method="get" action="/students">
  <div class="search">
    <%- include('../partials/icon', { name: 'search' }) %>
    <input type="search" name="q" value="<%= q %>" placeholder="Name or phone" aria-label="Search">
  </div>
  <select name="batch" aria-label="Class" data-autosubmit>
    <option value="">All classes</option>
    <% batches.forEach((b) => { %>
      <option value="<%= b.id %>" <%= b.id === batchId ? 'selected' : '' %>>Class <%= u.batchLabel(b) %></option>
    <% }) %>
  </select>
  <select name="status" aria-label="Status" data-autosubmit>
    <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
    <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Left / inactive</option>
  </select>
  <select name="pending" aria-label="Fee status" data-autosubmit>
    <option value="">Any fee status</option>
    <option value="1" <%= pendingOnly ? 'selected' : '' %>>Pending fees only</option>
  </select>
  <button class="btn" type="submit">Search</button>
</form>

<section class="card flush">
  <% if (!students.length) { %>
    <div class="empty">
      No students found.
      <% if (!q && !pendingOnly && status === 'active') { %><div style="margin-top: 12px;"><a class="btn btn-primary" href="/students/new">Add your first student</a></div><% } %>
    </div>
  <% } else { %>
  <ul class="list">
    <% students.forEach((s) => { %>
      <li><a class="list-item" href="/students/<%= s.id %>">
        <span class="avatar"><%= s.name.charAt(0).toUpperCase() %></span>
        <div class="list-main">
          <div class="list-title"><%= s.name %></div>
          <div class="list-sub">
            <span class="badge badge-class"><%= u.batchLabel(s) %></span>
            <% if (s.roll_no) { %>Roll <%= s.roll_no %><% } %>
            <% if (s.guardian_phone || s.phone) { %> · <%= s.guardian_phone || s.phone %><% } %>
          </div>
        </div>
        <div class="list-end">
          <% if (s.balance > 0) { %>
            <div class="num" style="font-weight: 700; color: var(--danger);"><%= u.inr(s.balance) %></div>
            <div class="list-sub">pending</div>
          <% } else if (s.balance < 0) { %>
            <span class="badge badge-paid">Advance <%= u.inr(-s.balance) %></span>
          <% } else { %>
            <span class="badge badge-paid">Paid up</span>
          <% } %>
        </div>
      </a></li>
    <% }) %>
  </ul>
  <% } %>
</section>
<%- include('../partials/foot') %>
