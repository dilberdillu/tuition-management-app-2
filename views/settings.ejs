<%- include('partials/head') %>
<div class="page-head"><h1>Settings</h1></div>

<div class="grid grid-2">
  <form class="card" method="post" action="/settings/fees">
    <div class="card-head"><h2>Monthly fee per class</h2></div>
    <p class="muted small" style="margin-top: 0;">New fees apply to months charged from now on. Past months keep the fee they were charged at.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Class</th><th class="num">Students</th><th>Fee (₹)</th></tr></thead>
        <tbody>
          <% batches.forEach((b) => { %>
            <tr>
              <td><strong><%= u.batchLabel(b) %></strong></td>
              <td class="num"><%= b.students %></td>
              <td style="width: 140px;"><input name="fee_<%= b.id %>" value="<%= b.monthly_fee %>" inputmode="numeric" aria-label="Fee for <%= u.batchLabel(b) %>" style="min-height: 38px;"></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <label style="display: flex; gap: 8px; align-items: center; font-weight: 500; margin: 14px 0;">
      <input type="checkbox" name="include_current" value="1" style="width: 20px; min-height: 20px;">
      Also change this month's (<%= u.monthLabel(u.currentMonth()) %>) fee
    </label>
    <button class="btn btn-primary btn-block" type="submit">Save fees</button>
  </form>

  <div class="stack">
    <form class="card" method="post" action="/settings/password">
      <div class="card-head"><h2>Change password</h2><span class="muted small"><%= user.username %></span></div>
      <% if (passwordError) { %><div class="errors"><%= passwordError %></div><% } %>
      <div class="field"><label for="current">Current password</label><input id="current" name="current" type="password" autocomplete="current-password" required></div>
      <div class="field"><label for="password">New password</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required></div>
      <div class="field"><label for="confirm">Confirm new password</label><input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required></div>
      <button class="btn btn-block" type="submit">Change password</button>
    </form>

    <section class="card">
      <div class="card-head"><h2>Center details</h2></div>
      <p class="muted small" style="margin-top: 0;">Shown on receipts. Change these in the server's <code>.env</code> file (CENTER_NAME, CENTER_ADDRESS, CENTER_PHONE) and restart.</p>
      <dl class="kv">
        <dt>Name</dt><dd><%= center.name %></dd>
        <dt>Address</dt><dd><%= center.address || '—' %></dd>
        <dt>Phone</dt><dd><%= center.phone || '—' %></dd>
      </dl>
    </section>

    <form method="post" action="/logout"><button class="btn btn-block" type="submit"><%- include('partials/icon', { name: 'logout' }) %> Log out</button></form>
  </div>
</div>
<%- include('partials/foot') %>
