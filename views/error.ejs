<% if (user) { %>
<%- include('partials/head') %>
<div class="card empty">
  <h1><%= title %></h1>
  <p><%= message %></p>
  <a class="btn btn-primary" href="/">Go to dashboard</a>
</div>
<%- include('partials/foot') %>
<% } else { %>
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title><link rel="stylesheet" href="/static/css/app.css"></head>
<body><main class="login-page"><div class="card login-card empty"><h1><%= title %></h1><p><%= message %></p>
<a class="btn btn-primary" href="/login">Log in</a></div></main></body></html>
<% } %>
