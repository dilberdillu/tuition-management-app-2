# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shown on the header and on PDF receipts
CENTER_NAME=My Tuition Center
CENTER_ADDRESS=
CENTER_PHONE=

# Fee used when the 12 classes (8A-10D) are first created. Change later in Settings.
DEFAULT_MONTHLY_FEE=2500

# Optional overrides
# DB_PATH=/var/lib/tuition/tuition.db
# TZ=Asia/Kolkata

# Online fee payments with Dodo Payments (optional; leave the API key empty to turn them off).
# Keys: Dodo dashboard > Developer > API keys. Test keys start with dodo_test_.
DODO_PAYMENTS_API_KEY=
# test_mode or live_mode. Anything else counts as test_mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Signing secret of the webhook endpoint https://<your-domain>/webhooks/dodo (Dodo dashboard > Developer > Webhooks).
DODO_PAYMENTS_WEBHOOK_KEY=
# Address used in payment links sent to parents. Defaults to the address the app was opened with.
# PUBLIC_URL=https://fees.example.com
