# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shown on the header and on PDF receipts
CENTER_NAME=My Tuition Center
CENTER_ADDRESS=
CENTER_PHONE=

# Fee used when the 12 classes (8A-10D) are first created. Change later in Settings.
DEFAULT_MONTHLY_FEE=2500

# Optional overrides
# DB_PATH=/var/lib/tuition/tuition.db
# TZ=Asia/Kolkata
